# Base de Datos PostgreSQL (Railway proporciona esta variable automáticamente con el plugin PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/luminavite?schema=public"

# AWS S3 Storage (Para subida directa de fotos 9:16 y música MP3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="TU_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="TU_AWS_SECRET_ACCESS_KEY"
AWS_S3_BUCKET_NAME="luminavite-storage"

# CDN opcional (CloudFront o URL pública directa de S3)
AWS_CLOUDFRONT_URL=""

# Siguiente URL pública base (ej. https://luminavite.up.railway.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contraseña maestra del panel administrativo (admin.clickandlove.app)
ADMIN_PASSWORD="ClickAndLove2026!"
ADMIN_SECRET="click-and-love-jwt-secret-session-2026"
