// Prisma Schema para SaaS de Invitaciones Digitales Interactivas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoEvento {
  BODA
  QUINCEANERA
  CUMPLEANOS
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum EstadoPedido {
  NUEVO
  CONTACTADO
  RECOPILANDO_DATOS
  EN_DISENO
  PUBLICADO
  CANCELADO
}

enum EstiloPlantilla {
  PRINCESA_ROSA           // Elsy (Réplica exacta de referencia)
  ELEGANT_ROSE            // T1: Isabella (Bilingüe, Video embed, Growing Up timeline)
  FAIRYTALE_CHATEAU       // T2: Emma & Lucas (Fairytale Castle Wedding, Hotel suites, Shuttles)
  BLUE_BUTTERFLY          // T3: Blue Butterfly Garden (Mariposas celestiales flotantes)
  CORALINE_MYSTICAL       // T4: Coraline Other World (Místico, Puerta secreta, Llave, Botones)
  CLASICA_IMPERIAL        // Clásica Imperial (Gala & Oro)
  ESMERALDA_ROYAL         // Esmeralda Royal
  JARDIN_BOTANICA         // Jardín Botánica
  MINIMALISTA_EDITORIAL   // Minimalista Editorial
  QUINCE_ROSADO           // Quince Rosado (Magdalena - Canva Réplica)
  BLUSH_PRINCESS          // T5: Blush Princess (Réplica Canva CouCou Printables, rosa y oro)
  QUINCE_ERA_PINK         // T6: Quince Era Pink (Réplica Canva The Hanger PH, rosa pastel)
  MISS_15                 // T8: Miss 15 Años (Réplica Canva, crema y cobre)
  BABY_BLUE               // T7: Baby Blue (Réplica Canva Studio Eburnean, azul bebé y plata)
}

enum RolUsuario {
  ADMIN
  SALON
  CLIENTE
}

model Usuario {
  id           String     @id @default(uuid())
  email        String     @unique
  nombre       String
  passwordHash String
  rol          RolUsuario @default(CLIENTE)
  salones      Salon[]
  eventos      Evento[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Salon {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombre    String
  slug      String   @unique
  telefono  String?
  direccion String?
  eventos   Evento[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Evento {
  id                 String          @id @default(uuid())
  usuarioId          String
  usuario            Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  salonId            String?
  salon              Salon?          @relation(fields: [salonId], references: [id], onDelete: SetNull)
  slug               String          @unique // URL pública: tudominio.com/[slug]
  panelToken         String?         // Token secreto para el Magic Link del cliente (Mamá): ?key=...
  panelShortCode     String?         @unique // Código corto /m/<code> (10 chars) que redirige al panel con el panelToken ACTUAL; regenerable sin tocar el token
  esDemo               Boolean         @default(false) // true = invitación de muestra (demo), se filtra aparte de los clientes
  tipoEvento         TipoEvento      @default(QUINCEANERA)
  estiloPlantilla    EstiloPlantilla @default(PRINCESA_ROSA)

  // Textos y Nombres
  titulo             String          // Ej: "Mis XV Años Elsy" o "Emma & Lucas"
  subtitulo          String?         // Ej: "An Unforgettable Celebration Awaits"
  mostrarFrasePersonalizada Boolean? @default(true) // Switch para mostrar/ocultar sección dedicatoria / frase emotiva
  frasePersonalizada String?         // Reflexión emocional ("From Girl to Señorita")
  frasePersonalizadaEn String?       // Reflexión emocional en inglés
  fechaEvento        DateTime        // Fecha y hora del evento
  fechaTextoPersonalizada String?    // Ej: "DECEMBER 05, 2026 AT 2 PM"

  // Multimedia (AWS S3)
  fotoPortadaUrl     String          // Imagen vertical 9:16 principal
  fotoInfanciaUrl    String?         // Foto de niña
  fotoActualUrl      String?         // Foto actual
  fotoCierreUrl      String?         // Foto de despedida / cierre
  fotoZapato1Url     String?         // Foto Zapato 1 (Zapatilla de cristal / Ceremonia)
  fotoZapato2Url     String?         // Foto Zapato 2 (Zapatilla en cojín / Corte y Damas)
  musicaUrl          String?         // URL del audio MP3 en S3
  musicaTitulo         String?         // Título de la canción que suena en la invitación
  reproducirMusicaAlAbrir Boolean    @default(true) // Reproducir automáticamente al abrir el sobre
  videoUrl           String?         // Enlace a video YouTube o MP4
  galeriaFotosUrls   String[]        @default([]) // Galería de fotos o hitos históricos

  // WhatsApp & RSVP
  telefonoWhatsappRsvp String        // Formato internacional sin símbolos: ej. "18181234567"
  emailOrganizador   String?         // Email del anfitrión/organizador para notificaciones en vivo
  aforoTotal         Int?            @default(200) // Balance total de pases estimados
  fechaLimiteRsvp    DateTime?
  maxPasesPorInvitado Int            @default(4)
  permitirConfirmacionTelefono Boolean? @default(true) // Switch para permitir confirmar por teléfono/llamada directa

  // Ubicación Ceremonia (Opcional)
  ceremoniaNombre    String?
  ceremoniaDireccion String?
  ceremoniaMapUrl    String?

  // Ubicación Recepción (Salón / Castillo)
  recepcionNombre    String
  recepcionDireccion String
  recepcionMapUrl    String          // Enlace directo a Google Maps o Waze

  // Placa de Fecha & Recinto (Paso 3)
  fechaPlacaMes      String?         // Ej: "OCTUBRE" / "OCTOBER"
  mostrarFechaPlacaHora Boolean?     @default(true) // Switch para mostrar/ocultar la hora en el medallón de fecha
  fechaPlacaHora     String?         // Ej: "A LAS 4:00 PM" / "AT 4 PM"
  fechaPlacaHoraEn   String?         // Ej: "AT 4:00 PM"
  fechaPlacaLugar    String?         // Ej: "GRAN SALÓN REAL"

  // Protocolo, Regalos y RSVP (Paso 4)
  countdownEncabezado String?        // Fallback: "Faltan sólo..."
  dressCodeEtiqueta  String?         // Ej: "Formal & Rigurosa Etiqueta"
  dressCodeColoresReservados String? // Ej: "Tonos azul celeste y blanco reservados exclusivamente para la quinceañera"
  regalosMensaje     String?         // Mensaje del cofre o lluvia de sobres
  regalosMensajeEn   String?         // Mensaje del cofre o lluvia de sobres en inglés
  mostrarMesaRegalos Boolean?        @default(true) // Switch para mostrar/ocultar sección mesa de regalos
  regalosZelle       String?         // Cuenta o teléfono de Zelle
  regalosCashApp     String?         // $Cashtag o cuenta opcional
  rsvpFechaLimite    String?         // Ej: "Favor de confirmar antes del 20 de Octubre"
  rsvpDiasAntes      Int?            @default(15) // Días de anticipación para confirmar RSVP
  autorBendicion     String?         // Autor o firma de la bendición
  textoDisco         String?         // Texto sobre el vinilo giratorio
  mensajeDespedida   String?         // Mensaje final o pie de página

  // Código de Vestimenta & Pautas
  mostrarDressCode   Boolean?        @default(true) // Switch para mostrar/ocultar sección código de vestimenta
  dressCodeTitulo    String?         // Ej: "BRING YOUR DANCING SHOES - DRESS CODE: Elegant & Formal"
  dressCodeTituloEn  String?         // Ej: "Formal & Elegant Attire"
  dressCodeNota      String?         // Ej: "Guests are encouraged to wear shades of white/formal"
  dressCodeNotaEn    String?         // Ej: "Blush pink tones reserved exclusively for the quinceañera"
  coloresReservados  String[]        @default([]) // Hex codes: ["#FFD1DC", "#FFFFFF"]
  celebrationGuideline String?       // Pautas (ej: niños/asientos en vals)

  // Enlaces especiales
  wishlistUrl        String?         // Enlace externo (Amazon, Target, etc.)
  idiomaDefault      String          @default("es") // "es" | "en" | "bilingual"

  // Estructuras dinámicas (JSON)
  itinerarioJson     Json?           // Array de eventos [{ time: "4:00 PM", title: "Llegada", icon: "car" }]
  corteHonorJson     Json?           // { chambelan: "Jeremiah", damas: [...], parents: "...", padrinos: [...] }
  mesaRegalosJson    Json?           // { titulo: "THE REGISTRY", mensaje: "...", plataformas: [...], datosBancarios: "..." }
  hospedajeJson      Json?           // { hotelNombre: "Oheka Castle", suitesInfo: "...", tarifas: "$250/night", link: "..." }
  transporteJson     Json?           // { shuttlesInfo: "Shuttles saldrán a las 4:30 PM..." }
  historiaHitosJson  Json?           // Array de hitos [{ anio: "2012", titulo: "...", fotoUrl: "...", texto: "..." }]
  configPlantilla    Json?           @default("{}") // Contenedor dinámico JSONB para variables por plantilla
  modalidadRsvp      String?         @default("HIBRIDO") // "ESTRICTO" | "HIBRIDO" | "ABIERTO"

  // Banner de contacto (barra fija comercial al pie de la invitación pública;
  // pensado para invitaciones de marketing, ej. la de la tarjeta impresa)
  bannerContactoActivo   Boolean?    @default(false) // Switch maestro del banner
  bannerContactoTexto    String?         // Ej: "¿Te gustó esta invitación? Haz la tuya"
  bannerContactoTelefono String?         // Número visible y de los botones, ej. "(818) 299-4882"
  bannerContactoLlamar   Boolean?        @default(true) // Mostrar botón Llamar (tel:)
  bannerContactoSms      Boolean?        @default(true) // Mostrar botón Texto (sms:)

  activo             Boolean         @default(true)
  vistasContador     Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  rsvps              RsvpRegistro[]
  guests             Guest[]
  ordenesCompra      OrdenCompra[]
}

model Guest {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  evento       Evento    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  email        String?   @db.VarChar(255)
  maxPax       Int       @default(1) @map("max_pax")
  confirmedPax Int       @default(0) @map("confirmed_pax")
  status       String    @default("pending") @db.VarChar(50) // 'pending', 'attending', 'declined', 'PENDIENTE_APROBACION'
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([eventId, name], name: "idx_guests_event_search")
  @@map("guests")
}

model RsvpRegistro {
  id             String   @id @default(uuid())
  eventoId       String
  evento         Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombreInvitado String
  telefono       String?  // Número de teléfono normalizado para control de duplicados
  email          String?  // Correo electrónico del invitado para notificaciones SES
  asistira       Boolean
  pases          Int      @default(1)
  acompanantes   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([eventoId, telefono], name: "eventoId_telefono")
}

model OrdenCompra {
  id                    String          @id @default(uuid())
  stripeSessionId       String          @unique
  stripePaymentIntentId String?
  montoTotal            Float
  moneda                String          @default("usd")
  paqueteId             String          // "basic" | "signature" | "atelier"
  paqueteNombre         String          // "Digital Basic", "Signature VIP", "Atelier Custom"
  estadoPago            EstadoPago      @default(PENDIENTE)
  estadoPedido          EstadoPedido    @default(NUEVO)

  // Datos del Cliente
  nombreCliente         String?
  emailCliente          String
  telefonoCliente       String?

  // Datos del Evento (completados en el Thank You page)
  tipoEvento            TipoEvento?     @default(QUINCEANERA)
  fechaEvento           DateTime?
  plantillaDeseada      EstiloPlantilla?
  comentarios           String?
  onboardingCompletado  Boolean         @default(false)

  // Relación opcional con Evento si ya se creó la invitación
  eventoId              String?
  evento                Evento?         @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String   @db.Text
  createdAt DateTime @default(now())

  @@index([code])
}

// Campañas de códigos QR dinámicos con tracking de escaneos (marketing).
// El QR impreso apunta a https://clickandlove.app/q/[code]; esa ruta registra
// el escaneo y redirige a targetUrl, que se puede cambiar sin reimprimir.
model QrCampaign {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  targetUrl String   @db.Text
  active    Boolean  @default(true)
  scans     QrScan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model QrScan {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    QrCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Hash sha256 de IP + User-Agent: aproxima visitantes únicos SIN guardar la IP cruda.
  visitorHash String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

model MasterTemplate {
  id                 String          @id @default(uuid())
  slug               String          @unique // ej: "mariposas-xv", "isabella-xv", "emma-and-lucas"
  nombre             String          // Nombre comercial en el catálogo
  categoria          TipoEvento      @default(QUINCEANERA)
  estiloPlantilla    EstiloPlantilla @default(BLUE_BUTTERFLY)

  // Textos Base
  titulo             String          // ej: "Valeria Morales"
  subtitulo          String?         // ej: "My Quinceañera"
  frasePersonalizada String?
  tipoLetra          String?         @default("Cinzel")

  // Multimedia & Audio
  musicaUrl          String?
  musicaTitulo       String?
  fotoPortadaUrl     String
  fotoInfanciaUrl    String?
  fotoActualUrl      String?
  fotoCierreUrl      String?

  // Sobre 3D
  colorSobre         String?         @default("#E8D5C4")
  colorSello         String?         @default("#C5A059")

  // Configuración adicional
  configExtra        Json?           @default("{}")
  activo             Boolean         @default(true)
  orden              Int             @default(0)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}


